---
import { compareDeliveries } from '../lib/delivery.mjs';
const trace = compareDeliveries(['17', '17']);
---

<details class="delivery-prints">
  <summary>
    <span class="separate">Pull the prints apart</span>
    <span class="stack">Stack the prints</span>
    <span class="print-sheet" aria-hidden="true">
      <svg viewBox="0 0 480 165">
        <defs>
          <g id="delivery-imprint" fill="none" stroke="currentColor">
            <path
              stroke-width="9"
              stroke-dasharray="45 3 19 1 6 2"
              d="m-50-12 12-33 38-13 34 12 22 33-5 37-27 26-35 3-33-18-11-25z"
            />
            <path stroke-width="2" d="m-40-10 11-26 28-10 26 9 18 25-4 29-21 21-28 1-25-13-8-21z" />
            <path stroke-width="6" d="M-22-4h43m-41 12h27m-9 12h15" />
          </g>
        </defs>
        <g class="print-first">
          <use href="#delivery-imprint" />
        </g>
        <g class="print-second">
          <use href="#delivery-imprint" />
        </g>
      </svg>
      <span class="imprints">
        <span>
          First ID <b data-print="first">17</b>
        </span>
        <span>
          Second ID <b data-print="second">17</b>
        </span>
      </span>
    </span>
  </summary>
  <p class="print-note">
    Deduplicating handler, second delivery · <strong>{trace.patched[1]}</strong>
  </p>
</details>
