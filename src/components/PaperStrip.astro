---
/* Each cubic describes the spine of a folded length of printer paper. The width
   at its ends is the visible width after the paper turns towards the viewer. */
type Bend = [number, number, number, number, number, number, number, string];
type Props = { start: [number, number, number]; bends: Bend[] };
const { start, bends } = Astro.props;
let [x, y, halfWidth] = start;
let travelled = 0;
let nextHole = 4;
const fmt = (n: number) => n.toFixed(1);
const point = (x: number, y: number) => fmt(x) + ',' + fmt(y);
const faces = bends.map(([cx, cy, dx, dy, ex, ey, endWidth, fill]) => {
  const left = [],
    right = [],
    holes = [],
    stitches = [],
    edge = [];
  let prevX = x,
    prevY = y;
  for (let i = 0; i <= 48; i++) {
    const t = i / 48,
      u = 1 - t;
    const px = u * u * u * x + 3 * u * u * t * cx + 3 * u * t * t * dx + t * t * t * ex;
    const py = u * u * u * y + 3 * u * u * t * cy + 3 * u * t * t * dy + t * t * t * ey;
    const tx = u * u * (cx - x) + 2 * u * t * (dx - cx) + t * t * (ex - dx);
    const ty = u * u * (cy - y) + 2 * u * t * (dy - cy) + t * t * (ey - dy);
    const length = Math.hypot(tx, ty);
    const nx = -ty / length,
      ny = tx / length;
    const width = halfWidth * u + endWidth * t;
    left.push(point(px + nx * width, py + ny * width));
    right.push(point(px - nx * width, py - ny * width));
    edge.push(point(px - nx * width * 0.86, py - ny * width * 0.86));
    travelled += Math.hypot(px - prevX, py - prevY);
    if (travelled >= nextHole) {
      holes.push(point(px + nx * width * 0.72, py + ny * width * 0.72));
      stitches.push(point(px - nx * width * 0.7, py - ny * width * 0.7));
      nextHole += 10;
    }
    prevX = px;
    prevY = py;
  }
  x = ex;
  y = ey;
  halfWidth = endWidth;
  return {
    face: 'M' + left.join(' L') + ' L' + right.reverse().join(' L') + 'Z',
    fill,
    edge: 'M' + edge.join(' L'),
    holes: holes.map((p) => 'M' + p + 'h.2').join(' '),
    stitches: stitches.map((p) => 'M' + p + 'h.15').join(' '),
  };
});
---

{faces.map(({ face, fill, edge, holes, stitches }) => (
  <g>
    <path d={face} fill={fill} stroke={fill} stroke-width=".5" />
    <path d={edge} fill="none" stroke="#fff1ee" stroke-width=".7" opacity=".65" />
    <path d={holes} fill="none" stroke="#2e1e23" stroke-width="3.5" stroke-linecap="round" />
    <path d={stitches} fill="none" stroke="#3c242d" stroke-width="1.7" stroke-linecap="round" />
  </g>
))}
