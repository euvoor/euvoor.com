---
import DeliveryPrints from './DeliveryPrints.astro';
import { specimen, comparePasses } from '../lib/ampersand.mjs';
import { compareDeliveries } from '../lib/delivery.mjs';
import ampersandSource from '../lib/ampersand.mjs?raw';
import deliverySource from '../lib/delivery.mjs?raw';
interface Props {
  kind: 'ampersand' | 'delivery';
}
const { kind } = Astro.props;
const amp = kind === 'ampersand';
const trace = amp ? comparePasses(specimen) : compareDeliveries(['17', '17']);
const labels = amp ? ['Execution', 'Permission check'] : ['First delivery', 'Second delivery'];
---

<section class="instrument" data-instrument={kind} aria-label="Interactive test bench">
  {!amp && <DeliveryPrints />}
  <form hidden class="controls">
    <label>
      {amp ? 'Input specimen' : 'First event ID'}
      <input name="first" value={amp ? specimen : '17'} maxlength="100" required={!amp} />
    </label>
    {!amp && (
      <label>
        Second event ID
        <input name="second" value="17" maxlength="100" required />
      </label>
    )}
    <button class="button" type="submit">
      <span aria-hidden="true">▶</span> {amp ? 'Run both paths' : 'Deliver both events'}
    </button>
  </form>
  <p class="fixture">Reference run · {amp ? 'input &' : 'event 17 delivered twice'}</p>
  <table>
    <caption class="sr-only">Comparison of handler output</caption>
    <thead>
      <tr>
        <th scope="col">Step</th>
        <th scope="col">Original</th>
        <th scope="col">{amp ? 'Patched' : 'Deduplicated'}</th>
      </tr>
    </thead>
    <tbody>
      {labels.map((label, i) => (
        <tr>
          <th scope="row">{label}</th>
          <td>
            <code>{trace.original[i]}</code>
          </td>
          <td>
            <code>{trace.patched[i]}</code>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="run-status" role="status" aria-live="polite"></p>
  <details>
    <summary>Inspect the bench code</summary>
    <pre><code>{amp ? ampersandSource : deliverySource}</code></pre>
  </details>
</section>
<script>
  import { comparePasses } from '../lib/ampersand.mjs';
  import { compareDeliveries } from '../lib/delivery.mjs';
  for (const bench of document.querySelectorAll<HTMLElement>('[data-instrument]')) {
    const form = bench.querySelector('form')!;
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const input = new FormData(form);
      const first = String(input.get('first') ?? '');
      const second = String(input.get('second') ?? '');
      const amp = bench.dataset.instrument === 'ampersand';
      const trace = amp ? comparePasses(first) : compareDeliveries([first, second]);
      bench.querySelectorAll('tbody tr').forEach((row, i) => {
        const cells = row.querySelectorAll('code');
        cells[0].textContent = trace.original[i] || '∅';
        cells[1].textContent = trace.patched[i] || '∅';
      });
      bench.querySelector('.fixture')!.textContent = amp
        ? 'Bench run · input ' + (first || '∅ (empty string)')
        : 'Bench run · event IDs ' + first + ' and ' + second;
      if (!amp) {
        bench.querySelector('[data-print="first"]')!.textContent = first;
        bench.querySelector('[data-print="second"]')!.textContent = second;
        bench.querySelector('.print-note strong')!.textContent = trace.patched[1];
      }
      const identical = trace.original[1] === trace.patched[1];
      bench.querySelector('.run-status')!.textContent = amp
        ? identical
          ? 'Both paths returned the same string.'
          : 'The second preparation changed the string.'
        : identical
          ? 'Two distinct IDs. Both handlers ran two jobs.'
          : 'One repeated ID. The second handler skipped the duplicate.';
    });
    form.hidden = false;
  }
</script>
