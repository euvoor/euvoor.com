---
import { Image } from 'astro:assets';
import flea from '../assets/hooke-flea.jpg';
---

<figure class="specimen">
  <div class="plate-info">
    <span>Hooke’s flea</span>
    <span>Plate XXXIV</span>
  </div>
  <fieldset class="microscope">
    <legend class="sr-only">Inspect Hooke’s engraving</legend>
    <input class="scope-radio" id="full-plate" type="radio" name="detail" checked />
    <label for="full-plate">Full plate</label>
    <input class="scope-radio" id="flea-head" type="radio" name="detail" />
    <label for="flea-head">Head ×2</label>
    <input class="scope-radio" id="flea-leg" type="radio" name="detail" />
    <label for="flea-leg">Hind leg ×2</label>
    <div class="scope">
      <div class="scope-disc"></div>
      <div class="plate-image">
        <Image
          src={flea}
          alt="Hooke’s engraved flea in profile, showing the joints of its long hind legs."
          width={1050}
          format="webp"
          quality={83}
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />
      </div>
      <span class="scope-cross cross-a" aria-hidden="true"></span>
      <span class="scope-cross cross-b" aria-hidden="true"></span>
    </div>
  </fieldset>
  <figcaption>
    <i>Micrographia</i>{' '}
    <a href="https://digital.sciencehistory.org/works/bk128c17q">
      Robert Hooke, 1665 <span aria-hidden="true">↗</span>
    </a>
  </figcaption>
</figure>
