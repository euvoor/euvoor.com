---
import Layout from '../components/Layout.astro';
---

<Layout
  title="Page missing"
  description="This address has no entry in the workshop."
  indexable={false}
>
  <div class="wrap section-page">
    <header class="section-heading">
      <div class="eyeline">Error 404</div>
      <h1>
        Missing evidence<i>.</i>
      </h1>
      <p>There’s no page at this address.</p>
      <a class="button" href="/">
        Return to the workshop →
      </a>
    </header>
  </div>
</Layout>
