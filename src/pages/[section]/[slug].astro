---
import { render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import Instrument from '../../components/Instrument.astro';
import { readArchive, sectionOf, neighbors, dateLabel, pathFor } from '../../lib/archive';
import { sections } from '../../lib/sections';

export async function getStaticPaths() {
  const archive = await readArchive();
  return archive.map((entry) => ({
    params: { section: sectionOf(entry), slug: entry.id.split('/')[1] },
    props: { entry, related: neighbors(entry, archive) },
  }));
}
const { entry, related } = Astro.props;
const section = sectionOf(entry);
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.summary} active={section}>
  <article class="wrap article">
    <a class="breadcrumb" href={'/' + section + '/'}>
      ← {sections[section].name}
    </a>
    <header class="article-head">
      <div class="eyeline">
        <span class="line"></span>
        {sections[section].singular} <span aria-hidden="true">/</span>{' '}
        <time datetime={entry.data.date.toISOString()}>{dateLabel(entry.data.date)}</time>
      </div>
      <h1>
        {entry.data.title}
        <i>.</i>
      </h1>
      <p class="deck">{entry.data.summary}</p>
    </header>
    {entry.data.instrument && section === 'laboratory' && (
      <Instrument kind={entry.data.instrument} />
    )}
    <div class="reading-layout">
      <div class="prose">
        <Content />
      </div>
      <aside class="margin-notes" aria-label="Sources and related work">
        {entry.data.evidence.length > 0 && (
          <section>
            <h2>Evidence</h2>
            <ul>
              {entry.data.evidence.map((item) => (
                <li>
                  <a href={item.url}>{item.label} ↗</a>
                </li>
              ))}
            </ul>
          </section>
        )}
        {related.length > 0 && (
          <section>
            <h2>On the same bench</h2>
            <ul>
              {related.map((item) => (
                <li>
                  <small>{sections[sectionOf(item)].singular}</small>
                  <a href={pathFor(item)}>{item.data.title} →</a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </aside>
    </div>
    {entry.data.instrument && section === 'case-files' && (
      <Instrument kind={entry.data.instrument} />
    )}
  </article>
</Layout>
