---
import Layout from '../../components/Layout.astro';
import { sections, type Section } from '../../lib/sections';
import { readArchive, sectionOf, dateLabel, pathFor } from '../../lib/archive';

export async function getStaticPaths() {
  return Object.keys(sections).map((section) => ({ params: { section } }));
}
const key = Astro.params.section as Section;
const section = sections[key];
const entries = (await readArchive()).filter((entry) => sectionOf(entry) === key);
---

<Layout title={section.name} description={section.description} active={key}>
  <div class="wrap section-page">
    <a class="breadcrumb" href="/">
      ← Workshop
    </a>
    <header class="section-heading">
      <div class="eyeline">
        <span class="line"></span> {entries.length} {entries.length === 1 ? 'entry' : 'entries'}{' '}
        on file
      </div>
      <h1>
        {section.name}
        <i>.</i>
      </h1>
      <p>{section.description}</p>
    </header>
    <ol class="entry-list">
      {entries.map((entry) => (
        <li>
          <a href={pathFor(entry)}>
            <time datetime={entry.data.date.toISOString()}>{dateLabel(entry.data.date)}</time>
            <div>
              <h2>{entry.data.title}</h2>
              <p>{entry.data.summary}</p>
            </div>
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </li>
      ))}
    </ol>
    {!entries.length && <p>No entries filed here yet.</p>}
  </div>
</Layout>
