---
import Layout from '../components/Layout.astro';
import PinnedTrace from '../components/PinnedTrace.astro';
import TraceMark from '../components/TraceMark.astro';
import { readArchive, dateLabel, pathFor, sectionOf, traceMarkFor } from '../lib/archive';
import { sections } from '../lib/sections';

const archive = await readArchive();
const pinned = archive.find((entry) => entry.id === 'case-files/an-ampersand-too-far');
if (!pinned) throw new Error('The pinned ampersand case is missing.');
---

<Layout
  title="Oussama’s workshop"
  description="Oussama Elgoumri’s engineering workshop. Pull the pin on a WooCommerce bug, run the tests, or read the case file."
>
  <PinnedTrace entry={pinned} />
  <section class="archive wrap" aria-labelledby="archive-title">
    <div class="archive-heading">
      <h2 id="archive-title">
        On file<span>.</span>
      </h2>
      <a href="/feed.xml">RSS ↗</a>
    </div>
    <ol class="register">
      {archive.map((entry) => (
        <li>
          <a href={pathFor(entry)}>
            <span class="entry-mark">
              <TraceMark kind={traceMarkFor(entry, archive)} />
            </span>
            <span class="entry-title">{entry.data.title}</span>
            <span class="entry-type">{sections[sectionOf(entry)].singular}</span>
            <time datetime={entry.data.date.toISOString()}>{dateLabel(entry.data.date)}</time>
            <span class="entry-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Layout>
